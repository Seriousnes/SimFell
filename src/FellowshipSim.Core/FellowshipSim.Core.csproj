<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Superpower" Version="3.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Each hero's default action lists (DefaultActionLists). -->
    <EmbeddedResource Include="Heroes\*\ActionLists\*.simc" />
    <!-- The built-in dungeons (DefaultDungeons). -->
    <EmbeddedResource Include="Dungeons\*.simc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FellowshipSim.Core.Generators\FellowshipSim.Core.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\FellowshipSim.Codex.Generators\FellowshipSim.Codex.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Game data in codex-export/ (tools/download-codex-export.sh): each creature's, dungeon's, hero's, ability's, talent's,
    legendary's, augmentation's, glyph's, weapon's and relic passive's class (FellowshipSim.Codex.Generators).
  -->
  <PropertyGroup>
    <CodexExportFolder>$(MSBuildThisFileDirectory)../../codex-export/</CodexExportFolder>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(CodexExportFolder)entities.jsonl" />
    <AdditionalFiles Include="$(CodexExportFolder)settings.json" />
  </ItemGroup>

  <!--
    Each generator's source files are written to Generated/<generator assembly>/<generator>/ as well as compiled from
    memory. Generated/FellowshipSim.Codex.Generators/ is committed, so a review shows each game data change. The files on
    disk are not compiled again.
  -->
  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
    <CodexGeneratedFolder>$(MSBuildThisFileDirectory)Generated/FellowshipSim.Codex.Generators/</CodexGeneratedFolder>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Generated/**" />
  </ItemGroup>

  <!--
    The Codex generators' files have one hash: SHA-256 over each file's path (relative, with /) and contents, in ordinal
    order of the path. <hash>.sha256 in the folder is named after it and lists each file's own hash. CI compares the
    committed name with its own build's (tools/check-codex-generated.sh).
  -->
  <UsingTask TaskName="WriteCodexGeneratedHash" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Folder ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var paths = Directory.GetFiles(Folder, "*.cs", SearchOption.AllDirectories)
            .Select(f => f.Substring(Folder.Length).TrimStart('/', '\\').Replace('\\', '/'))
            .OrderBy(p => p, StringComparer.Ordinal)
            .ToList();
        var all = IncrementalHash.CreateHash(HashAlgorithmName.SHA256);
        var each = SHA256.Create();
        var listing = new StringBuilder();
        foreach (var path in paths)
        {
            byte[] contents = File.ReadAllBytes(Path.Combine(Folder, path));
            all.AppendData(Encoding.UTF8.GetBytes(path + "\n"));
            all.AppendData(contents);
            all.AppendData(new byte[] { 0 });
            string fileHash = string.Concat(each.ComputeHash(contents).Select(b => b.ToString("x2")));
            listing.Append(fileHash).Append("  ").Append(path).Append('\n');
        }
        string hash = string.Concat(all.GetHashAndReset().Select(b => b.ToString("x2")));
        foreach (var old in Directory.GetFiles(Folder, "*.sha256"))
        {
            if (Path.GetFileName(old) != hash + ".sha256") File.Delete(old);
        }
        File.WriteAllText(Path.Combine(Folder, hash + ".sha256"), listing.ToString());
        Log.LogMessage(MessageImportance.Normal, "Codex generated files: " + hash);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="WriteCodexGeneratedHash" AfterTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true' And Exists('$(CodexGeneratedFolder)')">
    <WriteCodexGeneratedHash Folder="$(CodexGeneratedFolder)" />
  </Target>

</Project>
