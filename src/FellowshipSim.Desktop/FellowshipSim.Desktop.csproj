<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FellowshipSim</AssemblyName>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <!-- FellowshipSim.Service and FellowshipSim.EngineServer run inside this program, so their projects are libraries of it. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <!-- dotnet publish -r win-x64 makes one FellowshipSim.exe. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.13" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FellowshipSim.EngineServer\FellowshipSim.EngineServer.csproj" />
    <ProjectReference Include="..\FellowshipSim.Service\FellowshipSim.Service.csproj" />
  </ItemGroup>

  <!-- The page: built from FellowshipSim.Web and embedded, so the program is one file. -->
  <PropertyGroup>
    <WebDirectory>$(MSBuildThisFileDirectory)..\FellowshipSim.Web\</WebDirectory>
  </PropertyGroup>

  <ItemGroup>
    <WebSource Include="$(WebDirectory)src\**;$(WebDirectory)index.html;$(WebDirectory)package.json;$(WebDirectory)vite.config.ts" />
  </ItemGroup>

  <Target Name="InstallWeb" Condition="!Exists('$(WebDirectory)node_modules')">
    <Exec Command="pnpm install --frozen-lockfile" WorkingDirectory="$(WebDirectory)" />
  </Target>

  <!-- After the project references: building FellowshipSim.Service generates the page's src/api.ts. -->
  <Target Name="BuildWeb" DependsOnTargets="InstallWeb" AfterTargets="ResolveProjectReferences"
          Inputs="@(WebSource)" Outputs="$(WebDirectory)dist\index.html">
    <Exec Command="pnpm run build" WorkingDirectory="$(WebDirectory)" />
  </Target>

  <Target Name="EmbedWeb" AfterTargets="BuildWeb">
    <ItemGroup>
      <WebPage Include="$(WebDirectory)dist\**" />
      <EmbeddedResource Include="@(WebPage)" Link="wwwroot\%(WebPage.RecursiveDir)%(WebPage.Filename)%(WebPage.Extension)" WithCulture="false" />
    </ItemGroup>
  </Target>

</Project>
