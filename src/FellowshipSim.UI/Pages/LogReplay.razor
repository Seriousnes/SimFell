@page "/replay"
@inject LogReplayState State
@* Log Replay: import a logged fight and replay it, or read the reviews of the fights replayed so far. *@

<PageTitle>Log Replay - FellowshipSim</PageTitle>

<nav class="subtabs" aria-label="Log Replay">
    <button type="button" class="subtab @(State.Tab == LogReplayTab.Import ? "selected" : "")" aria-current="@(State.Tab == LogReplayTab.Import ? "page" : null)"
            @onclick="() => State.Tab = LogReplayTab.Import">Import a fight</button>
    <button type="button" class="subtab @(State.Tab == LogReplayTab.Reviews ? "selected" : "")" aria-current="@(State.Tab == LogReplayTab.Reviews ? "page" : null)"
            @onclick="() => State.Tab = LogReplayTab.Reviews">Reviews</button>
</nav>

@if (State.Tab == LogReplayTab.Import)
{
    <Import />
}
else
{
    <Reviews />
}
