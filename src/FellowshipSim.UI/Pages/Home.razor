@page "/"
@inject ISimEngine Engine

<PageTitle>FellowshipSim</PageTitle>

<h1>FellowshipSim</h1>

@if (_heroes is { } heroes)
{
    <p>Heroes: @string.Join(", ", heroes)</p>
}

@code {
    private IReadOnlyList<string>? _heroes;

    protected override async Task OnInitializedAsync() => _heroes = await Engine.GetHeroesAsync();
}
