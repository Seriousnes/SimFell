@page "/"
@using FellowshipSim.Logs
@implements IDisposable
@inject LogsSettingsStore Settings
@inject ReplayLibrary Library
@inject ReviewJobs ReviewJobs
@inject SimJobQueue Queue
@inject IReviewPages Pages

<PageTitle>FellowshipSim</PageTitle>

<SectionContent SectionName="@MainLayout.SubtitleSection">
    Replay a logged fight through the engine and review how closely it matches
</SectionContent>

<SettingsCard Hidden="!_settingsOpen" SettingsPath="@_settingsPath" FocusRequest="_settingsFocus" OnSaved="() => _settingsOpen = false" />

<ImportCard @bind-Status="_reportMessage" Busy="Busy" OnEditSettings="EditSettings" OnReplay="StartReview" />

<Card Title="Replay" Hidden="_reviewJob == null && _startError == null">
    @if (_startError != null)
    {
        <Message Kind="MessageKind.Error">@_startError</Message>
    }
    else if (_reviewJob is { } job)
    {
        @switch (job.Status)
        {
            case SimJobStatus.Done when job.Result is ReviewSummary r:
                <Message Kind="MessageKind.Ok">
                    Done:
                    <a href="@Pages.Url(r.HtmlFile)" target="_blank" rel="noopener">open the review of @r.PlayerName in @r.FightName</a>
                </Message>
                break;
            case SimJobStatus.Failed or SimJobStatus.Cancelled:
                <Message Kind="MessageKind.Error">@(job.Status == SimJobStatus.Cancelled ? "Cancelled" : job.Error ?? "The replay failed.")</Message>
                break;
            default:
                <Message>@(job.Message ?? "Starting")...</Message>
                break;
        }
    }
</Card>

<ReviewsCard Reviews="_reviews" />

<ActionListsCard />

@code {
    private bool _settingsOpen;
    private string _settingsPath = "";
    private int _settingsFocus;
    private MessageState _reportMessage = MessageState.None;
    private SimJob? _reviewJob;
    private string? _startError;
    private IReadOnlyList<ReviewSummary> _reviews = [];
    private readonly HashSet<string> _doneReviews = [];

    /// <summary>True while the review started here runs: the player buttons are disabled.</summary>
    private bool Busy => _reviewJob is { IsFinished: false };

    protected override void OnInitialized()
    {
        try
        {
            _settingsOpen = Settings.Credentials == null;
            _settingsPath = Settings.SettingsPath;
        }
        catch (Exception e)
        {
            _reportMessage = new MessageState(e.Message, MessageKind.Error);
        }
        LoadReviews();
        Queue.Changed += OnChanged;
    }

    private void OnChanged(SimJob job) => _ = InvokeAsync(() => JobChanged(job));

    private void JobChanged(SimJob job)
    {
        if (job.Kind != SimJobKind.Review) return;
        // A review that finishes, from this page or another, adds a row to the reviews.
        if (job.Status == SimJobStatus.Done && _doneReviews.Add(job.Id)) LoadReviews();
        StateHasChanged();
    }

    private void LoadReviews()
    {
        try
        {
            _reviews = Library.ListReviews();
        }
        catch (Exception)
        {
            // The reviews list keeps its rows; the next finished review reads the folder again.
        }
    }

    private void EditSettings()
    {
        _settingsOpen = true;
        _settingsFocus++;
    }

    private void StartReview(ReviewTarget target)
    {
        if (Busy) return;
        _startError = null;
        try
        {
            _reviewJob = ReviewJobs.Start(target.ReportCode, target.FightId, target.PlayerId);
        }
        catch (Exception e)
        {
            _reviewJob = null;
            _startError = e.Message;
        }
    }

    public void Dispose() => Queue.Changed -= OnChanged;
}
