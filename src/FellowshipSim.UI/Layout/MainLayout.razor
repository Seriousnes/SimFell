@inherits LayoutComponentBase
@implements IDisposable
@inject VisitorJobs Jobs
@inject FollowedReviews Followed
@inject IAppViews Views
@* The web app's frame: the heading, the menu of pages, the jobs menu and the page's line under the heading. *@
<header class="top">
    <div class="heading">
        <h1>FellowshipSim</h1>
        <nav class="nav">
            @foreach (var item in AppPage.All)
            {
                <NavLink @key="item.Route" href="@item.Route" Match="NavLinkMatch.All">@item.Title</NavLink>
            }
        </nav>
        <div class="results"><ResultsSidebar /></div>
    </div>
    <span class="subtitle"><SectionOutlet SectionName="@SubtitleSection" /></span>
</header>

<main class="main">
    @Body
</main>

@code {
    /// <summary>Name of the section each page fills with its line under the heading.</summary>
    public const string SubtitleSection = "subtitle";

    protected override void OnInitialized() => Jobs.Changed += OnChanged;

    // A review started from the Import page opens when it is done, whichever page shows.
    private void OnChanged(SimJob job) => _ = InvokeAsync(() =>
    {
        if (Followed.TakeDone(job, out var review)) Views.ShowReview(review.HtmlFile, ReviewTitle.Replay(review));
        else Followed.Forget(job);
    });

    public void Dispose() => Jobs.Changed -= OnChanged;
}
