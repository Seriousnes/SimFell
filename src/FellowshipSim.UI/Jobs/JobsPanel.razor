@* Sims and reviews in the job queue, oldest first, each with its progress and, once done, its result. *@
@using System.Globalization
@using FellowshipSim.Logs
@implements IDisposable
@inject SimJobQueue Queue
@inject IReviewPages Pages

<Card Title="Jobs">
    @if (Queue.List() is { Count: > 0 } jobs)
    {
        <ul class="jobs">
            @foreach (var job in jobs)
            {
                <li @key="job.Id" class="job @StatusClass(job.Status)">
                    <div class="job-head">
                        <span class="kind">@job.Kind</span>
                        <span class="job-title">@job.Title</span>
                        <span class="status">@job.Status</span>
                        <span class="actions">
                            @if (!job.IsFinished)
                            {
                                <button type="button" class="secondary-button" @onclick="() => Queue.Cancel(job.Id)">Cancel</button>
                            }
                            <button type="button" class="icon-button danger-button" title="Remove" aria-label="Remove"
                                    @onclick="() => Queue.Remove(job.Id)">✕</button>
                        </span>
                    </div>
                    <div class="bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Percent(job)">
                        <div class="fill" style="width: @Percent(job)%"></div>
                    </div>
                    <div class="meta">@(job.Message ?? "") <span class="percent">@Percent(job)%</span></div>
                    @if (job.Status == SimJobStatus.Failed)
                    {
                        <p class="field-error">@job.Error</p>
                    }
                    else if (job is { Status: SimJobStatus.Done, Result: SimResult sim })
                    {
                        <SimJobResult Result="sim" />
                    }
                    else if (job is { Status: SimJobStatus.Done, Result: ReviewSummary review })
                    {
                        <p class="review">
                            <a href="@Pages.Url(review.HtmlFile)" target="_blank" rel="noopener">Review of @review.PlayerName in @review.FightName</a>
                        </p>
                    }
                </li>
            }
        </ul>
    }
    else
    {
        <p class="hint">No jobs yet.</p>
    }
</Card>

@code {
    protected override void OnInitialized() => Queue.Changed += OnChanged;

    private void OnChanged(SimJob job) => _ = InvokeAsync(StateHasChanged);

    /// <summary>Progress in whole percent, in the invariant culture for the bar's CSS width.</summary>
    private static string Percent(SimJob job) =>
        Math.Floor((job.Progress ?? 0) * 100).ToString(CultureInfo.InvariantCulture);

    private static string StatusClass(SimJobStatus status) => status.ToString().ToLowerInvariant();

    public void Dispose() => Queue.Changed -= OnChanged;
}
