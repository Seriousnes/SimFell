@implements IDisposable
@inject SimJobQueue Queue
@inject IAppViews Views
@*
    The job queue behind one button: the button counts the running jobs, and opens a list of every job with its live
    progress. Picking a job shows it.
*@
<div class="jobs-menu" @onkeydown="OnKeyDown">
    <button type="button" class="toggle @(_open ? "open" : "")" aria-haspopup="true" aria-expanded="@(_open ? "true" : "false")"
            title="Jobs" @onclick="Toggle">
        <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M2.5 4h11M2.5 8h11M2.5 12h7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <span>Jobs</span>
        @if (Running > 0)
        {
            <span class="count" aria-label="@($"{Running} running")">@Running</span>
        }
    </button>
    @if (_open)
    {
        <div class="backdrop" @onclick="Close"></div>
        <div class="dropdown" role="menu">
            @if (Queue.List() is { Count: > 0 } jobs)
            {
                <ul class="jobs">
                    @foreach (var job in jobs)
                    {
                        <li @key="job.Id" class="job">
                            <button type="button" class="open" role="menuitem" @onclick="() => Show(job)">
                                <span class="job-head">
                                    <span class="kind">@job.Kind</span>
                                    <span class="job-title" title="@job.Title">@job.Title</span>
                                    <span class="status @job.Status.ToString().ToLowerInvariant()">@job.Status</span>
                                </span>
                                <JobProgress Job="job" />
                            </button>
                            <span class="actions">
                                @if (!job.IsFinished)
                                {
                                    <button type="button" class="secondary-button" @onclick="() => Queue.Cancel(job.Id)">Cancel</button>
                                }
                                <button type="button" class="icon-button danger-button" title="Remove" aria-label="Remove"
                                        @onclick="() => Queue.Remove(job.Id)">✕</button>
                            </span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="hint empty">No jobs yet. Sims and replays run here.</p>
            }
        </div>
    }
</div>

@code {
    private bool _open;

    private int Running => Queue.List().Count(j => j.Status == SimJobStatus.Running);

    protected override void OnInitialized() => Queue.Changed += OnChanged;

    private void OnChanged(SimJob job) => _ = InvokeAsync(StateHasChanged);

    private void Toggle() => _open = !_open;

    private void Close() => _open = false;

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _open = false;
    }

    private void Show(SimJob job)
    {
        _open = false;
        Views.ShowJob(job);
    }

    public void Dispose() => Queue.Changed -= OnChanged;
}
