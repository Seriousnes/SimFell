@inject IReviewPages ReviewPages
@*
    A review page from the reviews folder, in an iframe: the desktop app's review address is unreachable from the system
    browser, and a top-level link would replace the app page.
*@
<iframe class="page" src="@ReviewPages.Url(HtmlFile)" title="Replay review"></iframe>

@code {
    [Parameter, EditorRequired] public string HtmlFile { get; set; } = "";
}
