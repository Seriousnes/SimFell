@using System.Globalization
@using FellowshipSim.Logs
@inject IAppViews Views

<Card>
    <div>
        @if (Reviews.Count == 0)
        {
            <p class="hint">No reviews yet.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Player</th>
                            <th>Hero</th>
                            <th>Fight</th>
                            <th>Logged</th>
                            <th class="num" data-tooltip="Log hits the engine reproduced">Hits matched</th>
                            <th class="num" data-tooltip="Exact replay (the log decides crits, procs and targets): engine damage as a share of the log's">Replay vs log</th>
                            <th class="num" data-tooltip="Free dice (only the casts follow the log; the engine rolls its own crits and procs): the engine's average over many runs as a share of the log">Free dice vs log</th>
                            <th class="num" data-tooltip="Share of free-dice runs that dealt less than the log: near 50% means the log is a typical run; near 0% the engine is too high, near 100% too low">Log's place</th>
                            <th class="num" data-tooltip="Replay steps with no issues">Clean steps</th>
                            <th class="num" data-tooltip="Casts the engine would have refused but were forced to follow the log">Forced casts</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var review in Reviews)
                        {
                            var hits = review.LogHits != 0 ? (double)review.MatchedHits / review.LogHits : 0;
                            var damage = review.LogDamage != 0 ? review.EngineDamage / review.LogDamage : 0;
                            var date = review.FightDate is { } fightDate ? fightDate.ToLocalTime().ToString("d", CultureInfo.CurrentCulture) : "";
                            var fd = review.FreeDice;
                            <tr @key="review.Id">
                                <td><button type="button" class="link-button" @onclick="() => Views.ShowReview(review.HtmlFile, ReviewTitle.Replay(review))">@review.PlayerName</button></td>
                                <td>@review.Hero</td>
                                <td>@review.FightName <span class="meta">@review.ReportCode #@review.FightId</span></td>
                                <td>
                                    @date
                                    @if (review.FightDate is { } logged && !GamePatch.Current.Covers(logged, null))
                                    {
                                        <span class="old-patch" data-tooltip="@($"Logged before patch {GamePatch.Current.Name}, which the engine models: this review is no guide to the engine's accuracy now.")">old patch</span>
                                    }
                                </td>
                                <td class="num @RatioClass(hits, HitsGood, HitsWarn)">@Percent(hits)</td>
                                <td class="num @RatioClass(damage, DamageGood, DamageWarn)">@Percent(damage)</td>
                                @if (fd != null)
                                {
                                    var fdDamage = fd.EngineMean / fd.LogDamage;
                                    <td class="num @RatioClass(fdDamage, FreeDiceDamageGood, FreeDiceDamageWarn)"
                                        data-tooltip="@($"{fd.Runs} runs, engine 5-95%: {Math.Round(fd.Engine5, MidpointRounding.AwayFromZero):N0} - {Math.Round(fd.Engine95, MidpointRounding.AwayFromZero):N0}")">
                                        <button type="button" class="link-button" @onclick="() => Views.ShowReview(FreeDiceFile(review), ReviewTitle.FreeDice(review))">@Percent(fdDamage)</button>
                                    </td>
                                    <td class="num @PlaceClass(fd.LogPercentile)">@(Math.Round(fd.LogPercentile * PercentScale, MidpointRounding.AwayFromZero))%</td>
                                }
                                else
                                {
                                    <td class="num">-</td>
                                    <td class="num">-</td>
                                }
                                <td class="num">@review.PassedSteps/@review.TotalSteps</td>
                                <td class="num">@review.ForcedCasts</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</Card>

@code {
    private const string FreeDiceSuffix = ".freedice.html";

    /// <summary>The percent of a whole.</summary>
    private const int PercentScale = 100;

    /// <summary>The largest share a hit count may be off the log's and show as good.</summary>
    private const double HitsGood = 0.02;

    /// <summary>The largest share a hit count may be off the log's and show as a warning.</summary>
    private const double HitsWarn = 0.05;

    /// <summary>The largest share the damage may be off the log's and show as good.</summary>
    private const double DamageGood = 0.03;

    /// <summary>The largest share the damage may be off the log's and show as a warning.</summary>
    private const double DamageWarn = 0.08;

    /// <summary>The largest share the free-dice damage may be off the log's and show as good.</summary>
    private const double FreeDiceDamageGood = FellowshipSim.Engine.Replay.FreeDiceReportWriter.MeanGoodDeviation;

    /// <summary>The largest share the free-dice damage may be off the log's and show as a warning.</summary>
    private const double FreeDiceDamageWarn = FellowshipSim.Engine.Replay.FreeDiceReportWriter.MeanWarnDeviation;

    /// <summary>The log's place among the free-dice runs from which it shows as good.</summary>
    private const double GoodPlaceLow = FellowshipSim.Engine.Replay.FreeDiceReportWriter.PlaceOkLow;

    /// <summary>The log's place among the free-dice runs up to which it shows as good.</summary>
    private const double GoodPlaceHigh = FellowshipSim.Engine.Replay.FreeDiceReportWriter.PlaceOkHigh;

    /// <summary>The log's place among the free-dice runs from which it shows as a warning.</summary>
    private const double WarnPlaceLow = FellowshipSim.Engine.Replay.FreeDiceReportWriter.PlaceWarnLow;

    /// <summary>The log's place among the free-dice runs up to which it shows as a warning.</summary>
    private const double WarnPlaceHigh = FellowshipSim.Engine.Replay.FreeDiceReportWriter.PlaceWarnHigh;

    /// <summary>File name of the free-dice page of <paramref name="review"/>.</summary>
    private static string FreeDiceFile(ReviewSummary review) => $"{review.Id}{FreeDiceSuffix}";

    /// <summary>Reviews run so far, newest first.</summary>
    [Parameter] public IReadOnlyList<ReviewSummary> Reviews { get; set; } = [];

    private static string Percent(double ratio) => (ratio * PercentScale).ToString("F1", CultureInfo.InvariantCulture) + "%";

    private static string RatioClass(double ratio, double good, double warn)
    {
        var off = Math.Abs(1 - ratio);
        return off <= good ? "good" : off <= warn ? "warn" : "bad";
    }

    // Place of the log among the free-dice runs: near 50% is a typical run, near 0% or 100% means the engine is off.
    private static string PlaceClass(double place) =>
        place is >= GoodPlaceLow and <= GoodPlaceHigh ? "good" : place is >= WarnPlaceLow and <= WarnPlaceHigh ? "warn" : "bad";
}
