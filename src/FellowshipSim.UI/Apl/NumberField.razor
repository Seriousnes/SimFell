@using System.Globalization
@* The number a comparison reads; the condition takes it on leaving the field or on Enter. *@
<input type="number" step="any" class="value" aria-label="Value" value="@_draft" @onchange="Commit" />

@code {
    [Parameter] public double Value { get; set; }

    [Parameter] public EventCallback<double> OnChange { get; set; }

    private string _draft = "";

    protected override void OnInitialized() => _draft = ConditionBuilder.Number(Value);

    private Task Commit(ChangeEventArgs e)
    {
        _draft = e.Value as string ?? "";
        return OnChange.InvokeAsync(double.TryParse(_draft, NumberStyles.Float, CultureInfo.InvariantCulture, out double number) ? number : 0);
    }
}
