@using FellowshipSim.Core.APL
@using FellowshipSim.Core.APL.Expressions
@implements IAsyncDisposable
@inject IJSRuntime JS
@*
    The condition reference, a modal dialog <see cref="Open"/> shows: every part of an action line and every value a condition
    reads, each with its name in the editor and its meaning. Escape, Close and a click outside the dialog close it.
*@
<dialog @ref="_dialog" class="reference" aria-labelledby="apl-reference-title">
    <div class="head">
        <h2 id="apl-reference-title">Condition reference</h2>
        <form method="dialog">
            <button type="submit" class="secondary-button">Close</button>
        </form>
    </div>
    <div class="body">
        <p class="hint">
            A condition is true if its value is not 0.
            &lt;aura&gt;, &lt;ability&gt; and &lt;name&gt; are names in action-list form: lower case, _ for each space, and no punctuation. Example: Winter's Blessing is winters_blessing.
        </p>
        @foreach (var section in Sections)
        {
            <h3 id="@($"apl-reference-{section.Id}")">@section.Title</h3>
            @if (section.Hint != null)
            {
                <p class="hint">@section.Hint</p>
            }
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th class="syntax">Written</th>
                            <th class="label">Name in the editor</th>
                            <th>Meaning</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (syntax, doc) in section.Rows)
                        {
                            <tr @key="syntax">
                                <td class="syntax"><code>@syntax</code></td>
                                <td class="label">@doc.Label</td>
                                <td class="description">@doc.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</dialog>

@code {
    private const string ModulePath = JsInterop.ContentRoot + "apl/conditionReference.js";

    private const string OpenFunction = "open";

    /// <summary>What the reference writes in place of an ability's name in a path.</summary>
    private const string AbilityPlaceholder = "ability";

    /// <summary>What the reference writes in place of an aura's name in a path.</summary>
    private const string AuraPlaceholder = "aura";

    private ElementReference _dialog;
    private IJSObjectReference? _module;

    public async Task Open()
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>(JsInterop.ImportFunction, ModulePath);
            await _module.InvokeVoidAsync(OpenFunction, _dialog);
        }
        catch (JSDisconnectedException)
        {
            // The page is gone.
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module != null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The page is gone.
        }
    }

    private sealed record Section(string Id, string Title, string? Hint, IReadOnlyList<AplSyntaxDoc> Rows);

    private static readonly IReadOnlyList<Section> Sections = Build();

    private static IReadOnlyList<Section> Build()
    {
        return
        [
            new("action-line", "Action lines", null, AplActionOptions.All),
            new("operators", "Operators", "Operators apply in this order: prefixes, then *, % and %%, then + and -, then comparisons, then and, then or. Parentheses change the order.",
            [
                .. Enum.GetValues<UnaryOperator>().Select(op => new AplSyntaxDoc(op.Symbol() + "x", op.Doc())),
                .. Enum.GetValues<BinaryOperator>().Select(op => new AplSyntaxDoc($"a {op.Symbol()} b", op.Doc())),
            ]),
            new("scopes", "Scopes", null,
            [
                .. PropertyExpression.Scopes.Keys.Select(scope =>
                    new AplSyntaxDoc($"{scope}.<{(scope is PropertyExpression.CooldownScope or PropertyExpression.ActionScope ? AbilityPlaceholder : AuraPlaceholder)}>.<property>",
                        PropertyExpression.ScopeDocs[scope])),
                new AplSyntaxDoc($"{PropertyExpression.ActiveDotScope}.<aura>", PropertyExpression.ScopeDocs[PropertyExpression.ActiveDotScope]),
                new AplSyntaxDoc($"{PropertyExpression.VariableScope}.<name>", PropertyExpression.ScopeDocs[PropertyExpression.VariableScope]),
                .. PropertyExpression.BuildScopes.Select(scope => new AplSyntaxDoc($"{scope.Key}.<name>", scope.Value.Doc)),
            ]),
            new("aura", "Buff, debuff and dot properties", "buff refers to the hero. debuff and dot refer to the current target.",
                Properties(PropertyExpression.BuffScope, AuraPlaceholder)),
            new("cooldown", "Cooldown properties", null, Properties(PropertyExpression.CooldownScope, AbilityPlaceholder)),
            new("action", "Action properties", null, Properties(PropertyExpression.ActionScope, AbilityPlaceholder)),
            new("action-values", ConditionBuilder.ThisAction.Label, ConditionBuilder.ThisAction.Description,
                [.. PropertyExpression.ActionValues.Keys.Select(path => new AplSyntaxDoc(path, PropertyExpression.ActionValueDoc(path)!))]),
            new("resources", "Resources", ConditionBuilder.Resource.Description,
            [
                new AplSyntaxDoc("<resource>", PropertyExpression.ResourceCurrent),
                new AplSyntaxDoc(PropertyExpression.ResourcePrefix + "<resource>", PropertyExpression.ResourceCurrent),
                new AplSyntaxDoc("<resource>" + PropertyExpression.DeficitSuffix, PropertyExpression.ResourceDeficit),
            ]),
            new("fight-values", "Fight values", ConditionBuilder.FightValue.Description,
                [.. PropertyExpression.Named.Select(named => new AplSyntaxDoc(named.Key, named.Value.Doc))]),
        ];
    }

    private static IReadOnlyList<AplSyntaxDoc> Properties(string scope, string name) =>
        [.. PropertyExpression.Scopes[scope].Select(property => new AplSyntaxDoc($"{scope}.<{name}>.{property}", PropertyExpression.PropertyDoc(scope, property)!))];
}
