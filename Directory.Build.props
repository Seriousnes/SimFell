<Project>

  <!-- Every project and tools/*.cs reads the one user-secrets store "simfell" in development. -->
  <PropertyGroup>
    <UserSecretsId>simfell</UserSecretsId>
  </PropertyGroup>

  <!-- The build reports the .editorconfig code-style rules. -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
